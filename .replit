modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 8090
externalPort = 3000

[[ports]]
localPort = 23223
externalPort = 80

[[ports]]
localPort = 23224
externalPort = 4200

[deployment]
deploymentTarget = "vm"
run = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm --filter @workspace/zapflow run build && pnpm --filter @workspace/api-server run build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm --filter @workspace/zapflow exec vite --config vite.config.ts --host 0.0.0.0"
waitForPort = 5000

[userenv]

[userenv.shared]
PORT = "5000"
BASE_PATH = "/"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
